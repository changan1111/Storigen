# Auto-ID Linker (lite) settings. `python3 autoid.py init` copies this to autoid.env and fills in the secrets.
# Lines starting with # are comments. A real environment variable overrides a line here.

# ---------- how clips are tied to Blaze stories ----------
# placeholder = the journalist types rundown + story name, gets an ID, pastes it into the placeholder's Media Slug in that story.
# story_id    = IDs are made automatically when a feed (MOS gateway, passive tap, script) reports a story with Blaze's own story ID.
LINK_MODE=placeholder
# the clip ID (the file name the editor uses): name = DDMMYY_STORY_NAME (e.g. 111126_OPENING_MONTAGE, up to 100 characters of name; a new version adds _V2).
#   A story name that repeats the same day shares ONE clip name; every story still keeps its own internal ID (date + daily number + check letter, see View details).
#   legacy = YYYYMMDD_NNNNC_STORY_NAME as before. IDs already issued stay valid in either format.
ID_FORMAT=name
# stories that get an ID and show in the tracker but are attached by the DESK, never by the tool (whole title equals the name, optional number after it)
BLAZE_NO_AUTO_ATTACH=OPENING MONTAGE,END MONTAGE
# story_id mode only: typing IDs by hand is switched off unless this is 1 (fallback for a story that did not appear)
ALLOW_MANUAL=
# story_id mode: link that opens a story in Blaze. Copy a real story URL and replace its rundown / story parts with these two words.
# Example: http://10.1.10.xxx/blaze/#story/{blaze_rundown_id}/{blaze_story_id}
BLAZE_STORY_URL_TEMPLATE=

# ---------- this program ----------
WEB_HOST=0.0.0.0
WEB_PORT=8080
SERVICE_API_KEY=__API_KEY__
SESSION_SECRET=__SESSION_SECRET__
ADMIN_EMAIL=__ADMIN_EMAIL__
ADMIN_PASSWORD=__ADMIN_PASSWORD__
# set to 1 only if you put HTTPS in front of this program
COOKIE_SECURE=0
# Time zone name, e.g. Asia/Kolkata. Empty = this machine's clock.
AUTOID_TZ=
# The broadcast day (and the daily ID counter) starts at this time, not at midnight.
BROADCAST_DAY_START=05:00
# 1 = a user with an empty valid-upto date cannot sign in
VALID_UPTO_REQUIRED=1
ADMIN_CONTACT=

# ---------- folders the watcher reads (it never moves, copies or deletes anything in observe mode) ----------
# Mac: shares appear under /Volumes/<name>.   Windows: use UNC paths such as \\nas\Playout\INBOX (a service cannot see mapped drive letters).
WATCH_MODE=observe
EXPORTS_DIR=/Volumes/Playout/INBOX
INBOX_SUBDIRS=NEWS,PROGRAMS,PROMOS,ADS
NITRO_DIR=/Volumes/Nitro/ONAIR
# Where the finished files sit inside NITRO_DIR when they are in day folders, e.g. /Volumes/PLAYOUT/ONAIR/Nov-26/12-11-2026/file.mxf  ->  %b-%y/%d-%m-%Y
# (several patterns separated by |, e.g. %b-%y/%d-%m-%Y|%m_%b-%y/%d-%m-%Y for month folders like 10_Oct-26). Only yesterday's, today's and tomorrow's folders are scanned. Empty = scan the whole tree.
NITRO_DATE_PATH=
EXTS=.mov,.mp4,.mxf
NITRO_EXTS=.mxf
NITRO_SCAN_DEPTH=3
# 1 = refuse to run if a folder is not a network share (catches an unmounted NAS)
REQUIRE_NETWORK_FS=1
STABLE_SECS=30
POLL_SECS=5
# the original left the inbox but no MXF with that ID appeared on Nitro after this long: tell the desk
DONE_WAIT_SECS=900
# a file has sat in the inbox this long: the conversion is probably failing
INBOX_STUCK_SECS=1800

# ---------- optional MOS feed from Blaze (needs a MOS device entry in Blaze pointing to this machine) ----------
MOS_ENABLED=0
MOS_PORTS=10540,10541
# IDs only for these rundowns: comma separated; each entry is an exact roID or text found in the rundown name. Empty = all rundowns Blaze sends.
ONLY_RUNDOWNS=

# ---------- alerts (optional) ----------
ALERT_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=25
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=autoid@localhost


# ---- READY FEED (v10.2.0): the dashboard's "Ready feed" button lists, with a search box, every clip whose file is in Blaze's media list (story, clip ID, MOS object ID,
#      media name, status), and shows a toast when a new one becomes ready. To ALSO get a chat message the moment a clip becomes ready, put a Teams / Slack style incoming webhook here.
#      Empty (default) = no message. It is separate from ALERT_WEBHOOK_URL, so the channel for failures stays quiet. One message per clip (a replaced file counts as news again). Restart to apply.
# READY_WEBHOOK_URL=
# ---------- Blaze DataService poller (tools/blaze_poll.py): reads stories from Blaze, no MOS and no licence needed ----------
BLAZE_POLL=0
BLAZE_URL=http://10.1.10.XXX
# The poller can log in to Blaze by itself (v9.7.3): set BLAZE_USERNAME and BLAZE_PASSWORD_HASH and leave BLAZE_SESSION_ID empty. It logs in at start and again whenever the session expires, and writes
# the new session into the BLAZE_SESSION_ID line below. BLAZE_PASSWORD_HASH is NOT the typed password: it is the `password=` value the Blaze page sends in its login request (POST /DataService/sessions;
# copy it from DevTools > Network, the percent-encoded form is fine). Treat it like a password: it gets you into Blaze.
# Or, without auto-login, copy the two cookies from a logged-in Blaze tab (DevTools > Application > Cookies); they expire and must then be renewed by hand.
BLAZE_SESSION_ID=
BLAZE_USERNAME=
BLAZE_PASSWORD_HASH=
# 0 = never log in by itself (cookies only). BLAZE_LOGIN_MIN_SECS = pause between login tries; after BLAZE_LOGIN_MAX_FAILS failures in a row auto-login stops (protects the account) and an alert is sent.
BLAZE_AUTOLOGIN=1
BLAZE_LOGIN_MIN_SECS=60
BLAZE_LOGIN_MAX_FAILS=3
# rundown (show) IDs to follow, comma separated. 34427 is the number in /DataService/shows/34427/slugs
# auto = follow every show of the broadcast day, found by asking Blaze (recommended). Or list fixed show IDs, comma separated.
BLAZE_SHOW_IDS=auto
BLAZE_POLL_SECS=15
# How the Blaze file of each story is found (v9.7.4). list = read the day's media list ONCE per round (1 to 5 requests, whatever the number of stories) and match every story in code. search = one title search per story (older way).
BLAZE_MEDIA_MODE=list
# list mode: files per request and the most requests per round (200 x 5 = the newest 1000 files of the last BLAZE_MEDIA_DAYS days). Stories not in a list that was cut short are searched by title.
BLAZE_MEDIA_PAGE=200
BLAZE_MEDIA_MAX_PAGES=5
BLAZE_MEDIA_DAYS=2
# a media file is accepted only after it has not changed for this long
BLAZE_MEDIA_SETTLE_SECS=60
# off = only read stories; dry = also find the clip in Blaze's media list and PRINT the attach call it would make (nothing is sent)
BLAZE_ATTACH=dry
# template rows that never get an ID: the whole title equals a name here (an optional number after it is fine: BREAK1, BREAK2)
BLAZE_IGNORE_TITLES=OPEN MONTAGE,OPEN HEADLINE,BREAK,ONE MIN STING,CLOSING MONTAGE,CLOSING HEADLINE,CLOSE HEADLINE,EXPESS MONTAGE
# read-back: when Blaze already shows a clip with our ID in the right story, mark it ATTACHED in Auto-ID (never writes to Blaze)
BLAZE_CONFIRM=1
BLAZE_RECONCILE_SECS=60
# Reconcile asks Blaze for a story's clips only when the clip count in the slugs list changed, or at least this often (seconds): catches a file swapped for another one.
BLAZE_FULL_RECON_SECS=600
# a file found this long ago and still not attached is listed as OVERDUE in the daily report
BLAZE_OVERDUE_MIN=15
# only these Blaze story formats get IDs (empty = all). Your rundown: 20 Anchor, 21 Anchor visual, 23 Package, 25 HeadLines, 27 Montage, 30 BREAK.
# Example for stories that need an editor clip:  BLAZE_ONLY_FORMAT_IDS=20,21,23,27   (the title list above still removes the template Montage rows)
BLAZE_ONLY_FORMAT_IDS=
# ---- LIVE ATTACH: OFF while BLAZE_ATTACH=dry (log only). Change BLAZE_ATTACH to live to attach for real (use the QUICKTEST_ lines below to try one story or show first). ----
# optional: only these shows may receive a real attach (must also be in BLAZE_SHOW_IDS). Empty = no restriction.
BLAZE_LIVE_SHOW_IDS=
# with BLAZE_SHOW_IDS=auto the show IDs change daily: allow live by time slot (masterId, see: blaze_poll.py shows), e.g. 13 = the 06:30 AM bulletin
BLAZE_LIVE_MASTER_IDS=
# after a live attach set the story script duration to the clips' total, as the page does (only when the story has no script time of its own)
BLAZE_LIVE_SCRIPTDUR=1
# optional limit of real attaches per hour. 0 = no limit.
BLAZE_LIVE_MAX_PER_HOUR=0
# live stops by itself (creates the kill-switch file) after this many failed attaches in a row
BLAZE_LIVE_HALT_AFTER=3
# ---- QUICK_TEST_BUTTON (v9.13): 1 = (default) every story card has "Quick test attach" (enabled only when its NITRO step is green): Yes / No, then ONE real attach of that clip, even while BLAZE_ATTACH=dry.
# 0 = no button. Safety checks stay (verified format, kill switch file, one attempt per clip). See docs/CHANGES_v913.md.
QUICK_TEST_BUTTON=1

# ---- STORY SCRIPTS (v9.13.2): every story card (and its details) shows the two script fields Blaze keeps for the story (storyComplete -> versions[0].items[].text1 and text2), in two boxes.
# BLAZE_SCRIPTS=1 reads them (0 = off). Each story is read again every BLAZE_SCRIPT_SECS (min 15), so an edit in Blaze shows up that soon; at most BLAZE_SCRIPT_BATCH stories (min 5) are read per polling round,
# so after the upgrade the stories already in the database fill in over a few minutes. Reading only: nothing is written to Blaze. Restart the service after changing these.
BLAZE_SCRIPTS=1
BLAZE_SCRIPT_SECS=120
BLAZE_SCRIPT_BATCH=40
# The names above the two boxes (text1 box, text2 box). Restart the web service after changing them.
SCRIPT_LABEL_ONLINE=Online script
SCRIPT_LABEL_ANCHOR=Anchor script

# ---- WATCHER_ENABLED (v9.12): 1 = (default) the watcher reads the Playout INBOX and Nitro ON AIR folders (EXPORT and ON AIR steps, needs them mounted).
#      0 = no folders needed at all: the watcher is not started, no "NAS or Nitro folder not reachable" warning, the doctor skips the folder check, the dashboard shows NITRO and ATTACHED only.
#      Use 0 when the folders are not mounted on this machine (needs BLAZE_ATTACH_WHEN=media, the default). Restart after changing it.
WATCHER_ENABLED=1

# ---- BLAZE_ATTACH_WHEN (v9.8.1): when a clip may be attached for real (only used while BLAZE_ATTACH=live).
#   media   = (default) Blaze's media list is enough: the file is found there, settled and converted. The NAS watcher is NOT needed.
#   watcher = also wait until the NAS watcher has seen the clip on Nitro (state ON_NITRO). Use it only if the NAS is mounted on this machine.
BLAZE_ATTACH_WHEN=media

# ---- QUICKTEST (v9.7.5): test real attaching on ONE story or ONE show first. Only used while BLAZE_ATTACH=live.
# Leave all three empty = every followed show gets real attaches (full live). Fill one to narrow it, then clear it when you are happy.
# Python3 tools/blaze_poll.py quicktest <story id>   shows what will happen for a story, sends nothing.
QUICKTEST_STORY_ID=
QUICKTEST_SHOW_ID=
# with BLAZE_SHOW_IDS=auto the show ID changes every day: use the time slot (masterId, see: blaze_poll.py shows) instead
QUICKTEST_SLOT_ID=
# kill switch: while this file exists nothing is sent. Empty = data/STOP_LIVE. Create it to stop live at once; delete it to resume.
BLAZE_LIVE_STOP_FILE=
# the keep-alive, as the Blaze page does it (captured over 2.2 hours): a GET on the session every minute and a PUT every 8 minutes. get, put or both (every call) are also possible.
BLAZE_HEARTBEAT=page
# story formats whose itemId rule is confirmed (20 = Anchor). Other formats still get a GOING TO ATTACH line, tagged CHECK, so the days of watching also verify them.
BLAZE_VERIFIED_FORMATS=20,21
# a clip's file is searched for again in Blaze's media list at most this often (seconds)
BLAZE_MEDIA_RETRY_SECS=30
# the READY ON NITRO / GOING TO ATTACH lines are also appended here (empty = data/reports/attach_watch.log)
BLAZE_WATCH_LOG=
# where the poller writes the daily report files (CSV and HTML); the web page /report reads the same folder. Empty = data/reports.
BLAZE_REPORT_DIR=
# ---- complete-day polling (BLAZE_SHOW_IDS=auto): EVERY show of the day is read EVERY pass, in parallel. There is no hot or cold tier any more.
# requests to Blaze in flight at once (the Blaze page itself sent 8 slug requests within 2 seconds), and how long one request may take before the show is given up and retried
BLAZE_CONCURRENCY=6
BLAZE_TIMEOUT_SECS=15
# a show that fails keeps its last good snapshot and is retried: next pass, then after the poll interval x1, x2, x4 ... up to this many seconds
BLAZE_RETRY_MAX_SECS=60
# a show not read successfully for longer than FRESH counts as over the freshness target (default: the poll interval); longer than STALE it is a problem on the status pill
BLAZE_FRESH_SECS=15
BLAZE_STALE_SECS=90
# attachment identity: each story that has clips is re-read (clip IDs, media IDs, names, lengths) this often, at most IDENT_BATCH stories per pass. A clip swapped for one of the same length is only noticed by this sweep: lower = noticed sooner, more requests.
BLAZE_IDENT_SECS=120
BLAZE_IDENT_BATCH=60
# full story reads (story title, items): at most RECON_BATCH per reconcile pass, every BLAZE_FULL_RECON_SECS per story
BLAZE_RECON_BATCH=60
# the registry is re-sent a show's stories at least this often even when nothing changed
BLAZE_SYNC_FULL_SECS=300
# finding the finished file in Blaze's media list: clips whose export was seen are searched every BLAZE_MEDIA_RETRY_SECS; clips with no export seen yet every MEDIA_WAIT (default 4 x RETRY), at most MEDIA_BATCH searches per pass
BLAZE_MEDIA_WAIT_SECS=
BLAZE_MEDIA_BATCH=40
# the story details behind a plan line are re-read at most this often
BLAZE_INFO_SECS=60
# 1 = also follow tomorrow's shows; words (comma separated) that, when they appear in a show's title, make it ignored (for example TEST); how often the day's show list is asked again
BLAZE_SHOW_DAYS_AHEAD=0
BLAZE_IGNORE_SHOW_TITLES=
BLAZE_SHOW_LIST_SECS=60
# ---- v9.5 ---------------------------------------------------------------------------------------------------------------------------------------------
# how long one round waits for its parallel reads (default: the poll interval). A read still running then is NOT started again: it finishes in the background and its answer is used by the next round.
BLAZE_CYCLE_DEADLINE_SECS=
# a read that failed for a network or 5xx reason is retried this many times, quickly, while the round has time left (0 = off, max 3). An expired session is never retried.
BLAZE_REQUEST_RETRIES=1
# 1 = a show Blaze stops listing after it aired is still followed until the broadcast day closes (0 = drop it from the follow list as soon as Blaze stops listing it)
BLAZE_KEEP_COMPLETED=1
# a show that started longer ago than this many minutes counts as finished
BLAZE_HOT_BEFORE_MIN=60
# snapshots and the change history older than this many days are deleted (the daily report files are not touched)
BLAZE_SNAPSHOT_KEEP_DAYS=14
# v9.5.1: shows Blaze lists under TOMORROW's date but that start within this many hours from now AND before the broadcast day ends (BROADCAST_DAY_START, default 05:00) are followed already: a 00:00 show is followed from 19:00 on
# (with 5). 0 = off. A show starting at or after the day end is not taken early: it comes with the normal list when the day rolls over.
BLAZE_SHOW_LOOKAHEAD_HOURS=5
# v9.6: a clip of version 2 or higher (the desk pressed "+ Version" and exported a file ending _V2, _V3 ...).
#   desk (default) = the tool NEVER attaches it. The card goes to the desk ("New version ready") and the dashboard banner shows; the desk attaches the new clip and removes the old one in Blaze.
#   auto           = needs BLAZE_ATTACH=live. The tool attaches the new clip and reads the story back; ONLY if that is exactly right it removes the older version's clip (a second call, DELETE) and reads back again.
#                    Never delete first. Not done (left to the desk) when the story is linked in several shows, holds more than one older version, or any other live rule blocks. If the delete fails the story keeps both clips and the desk is alerted.
#                    Try it first with BLAZE_ATTACH=dry: the log then shows the attach and the delete it WOULD send.
BLAZE_VERSION_MODE=desk

# ---- PREVIEW (v10.1.0): a Play button in the Media & IDs pane plays the clip from the Nitro ONAIR folder (NITRO_DIR, so the web service must see that folder).
# Nothing is saved: each Play converts the MXF to a small H.264 stream with ffmpeg and sends it straight to the browser. It runs only when someone presses Play,
# at low CPU priority, and stops as soon as the page is closed or another story is chosen. Needs ffmpeg on this machine. PREVIEW_ENABLED=0 removes the button. Restart after changing.
PREVIEW_ENABLED=1
# how many previews may run at the same time (the others are told to try again)
PREVIEW_MAX_JOBS=1
PREVIEW_HEIGHT=360
PREVIEW_THREADS=2
# a preview is stopped after this many seconds
PREVIEW_MAX_SECONDS=900
