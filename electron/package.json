{
  "name": "storigen-desktop",
  "version": "11.0.0",
  "description": "Storigen dashboard in its own desktop window",
  "main": "main.js",
  "author": "Storigen",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.storigen.desktop",
    "productName": "Storigen",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "setup.html", "setup.js", "package.json"],
    "mac": { "target": ["dmg"], "category": "public.app-category.productivity" },
    "win": { "target": ["nsis"] },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true }
  }
}
